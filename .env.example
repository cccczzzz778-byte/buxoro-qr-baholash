# Buxoro QR Baholash — production environment
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Optional direct/unpooled URL for migrations
DATABASE_URL_UNPOOLED=

# Initial central administrator
ADMIN_USERNAME=admin
# Minimum 12 characters. Used to seed the initial admin password on a fresh database.
ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD

# Minimum 32 random characters; never commit the real value.
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Public HTTPS origin used inside generated QR links.
# Example: https://your-domain.example
PUBLIC_BASE_URL=
